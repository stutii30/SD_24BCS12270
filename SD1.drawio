  <diagram name="Page-1" id="04ozeC0jHYagebucsYxY">
    <mxGraphModel dx="766" dy="454" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="HKxMzrTmIKkLUWZ1Zoss-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Functional Requirements&lt;div&gt;1. Take URL input from user&lt;/div&gt;&lt;div&gt;2. Return a shortened URL which redirects to the page&lt;/div&gt;&lt;div&gt;3. Delete a URl if not needed anymore&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="220" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="HKxMzrTmIKkLUWZ1Zoss-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Non - Functional Requirements&lt;div&gt;1. every url should be unique&lt;/div&gt;&lt;div&gt;2. the link should not lag while redirecting&lt;/div&gt;&lt;div&gt;3. system should not crash when multiple users login(load balancer)&lt;/div&gt;&lt;div&gt;4. if link is being used a lot, it should be stored in cache, if its not being used at all, it could be discarded.&lt;/div&gt;&lt;div&gt;5. the service should always be available and even if some issue occurs, it shouldn&#39;t stop the entire working&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="210" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="HKxMzrTmIKkLUWZ1Zoss-6" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;" value="API Methods:&amp;nbsp;&lt;div&gt;1. GET: We will use this method to take the input of the URL&lt;/div&gt;&lt;div&gt;2. POST: This method will be used to display the generated URL&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="150" x="280" y="20" as="geometry" />
        </mxCell>
        <mxCell id="HKxMzrTmIKkLUWZ1Zoss-9" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;" value="Estimation:&lt;div&gt;100M writes/day--1160 writes/second&lt;/div&gt;&lt;div&gt;Reads-10:1 ratio-11600 reads/day&lt;/div&gt;&lt;div&gt;If it runs for 10 years; 100M*365*10=365B records&lt;/div&gt;&lt;div&gt;if URL length=100 bytes&lt;/div&gt;&lt;div&gt;Storage for 10 years=100 bytes *365 B=36.5 TB&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="220" x="470" y="10" as="geometry" />
        </mxCell>
